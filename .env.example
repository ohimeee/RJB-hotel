# Copy this file to .env and fill in your own credentials.

# The shared Supabase Postgres — ask the team for it. Nothing to install.
#
# Take the SESSION POOLER string from Dashboard -> Connect -> Session pooler.
# The "direct connection" string is IPv6-only and times out on most home
# connections here, which looks exactly like a broken app.
#
# Treat this as a password: it is full read/write access to the team's data.
# .env is gitignored — send it in a DM, never in a group chat or a screenshot.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"


# Optional. Supabase's SSL certificate (Dashboard -> Settings -> Database ->
# SSL certificate), pasted as one line. Without it the connection is still
# encrypted, but the server's identity is not verified.
# DATABASE_CA_CERT=

# Xendit test-mode credentials. Dashboard > Settings > Developers.
# The secret key must stay server-side — never behind NEXT_PUBLIC_.
XENDIT_SECRET_KEY=xnd_development_...
# Settings > Webhooks > "View Webhook Verification Token". Sent as the
# x-callback-token header on every webhook; compare it before trusting a payload.
XENDIT_CALLBACK_TOKEN=...

# Where Xendit sends the guest back to, and the origin it posts webhooks at.
# In development this must be your ngrok URL, not localhost — Xendit's servers
# cannot reach your machine, so with localhost no booking ever confirms.
APP_URL=http://localhost:3000
